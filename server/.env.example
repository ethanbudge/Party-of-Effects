# Copy to server/.env and fill in. This file is gitignored.

# ---- Supabase -------------------------------------------------------------
# Project Settings -> Data API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Project Settings -> API Keys -> service_role.
# THIS KEY BYPASSES ALL ROW LEVEL SECURITY. Server only. Never put it in web/.
SUPABASE_SERVICE_ROLE_KEY=

# Only needed on older Supabase projects that sign JWTs with HS256.
# Newer projects use asymmetric keys and this can be left blank — the server
# falls back to verifying against your project's JWKS endpoint.
SUPABASE_JWT_SECRET=

# ---- Secret storage -------------------------------------------------------
# Encrypts every stored LIFX token and Spotify refresh token (AES-256-GCM).
# Generate with:  openssl rand -base64 32
# If you lose this, everyone has to reconnect LIFX and Spotify. It is the only
# thing standing between a database dump and your friends' smart home tokens.
CREDENTIAL_ENC_KEY=

# ---- Spotify --------------------------------------------------------------
# https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must match a Redirect URI registered on the Spotify app EXACTLY.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8787/api/spotify/callback

# ---- App ------------------------------------------------------------------
# Where the browser app is served from. Used for CORS and the OAuth bounce-back.
WEB_APP_URL=http://127.0.0.1:5173
PORT=8787
