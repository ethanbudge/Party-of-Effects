# Copy to web/.env and fill in. This file is gitignored.
#
# Everything here ships to the browser. That is fine — the anon key is designed
# to be public and is useless without a valid login, because every table it can
# reach is guarded by Row Level Security. The service_role key must NEVER
# appear in this file.

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=

# Where the API server is running.
VITE_API_BASE_URL=http://127.0.0.1:8787
